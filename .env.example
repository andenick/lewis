# Copy this file to .env and fill in your own values.
# The platform reads these at runtime; none are committed.

# Where the platform READS source/input data from (default: ./data)
DATA_ROOT=data

# Where the platform WRITES its generated outputs to (default: ./outputs)
OUTPUT_ROOT=outputs

# --- API keys (all free; bring your own) ---

# FRED API key — https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# Banco de Mexico SIE API token — https://www.banxico.org.mx/SieAPIRest/service/v1/token
BANXICO_TOKEN=

# UN Comtrade API key — https://comtradeplus.un.org/
COMTRADE_API_KEY=
