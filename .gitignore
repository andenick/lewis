*.xls
*.csv
*.tsv
*.pdf
*.png
*.jpg
*.jpeg
*.gif
*.docx
*.doc
*.pptx
*.h5
*.nc
*.dta
*.sav

# --- Notebooks (often embed large data/outputs) ---
*.ipynb

# --- Caches / build ---
__pycache__/
*.pyc
*.pyo
*.egg-info/
.eggs/
.pytest_cache/
**/.pytest_cache/
.ipynb_checkpoints/
*_cache/
.mypy_cache/
.ruff_cache/
build/
dist/
node_modules/

# --- Virtual envs ---
.venv/
venv/
env/
ENV/

# --- Secrets / credentials ---
*.env
.env
.env.*
!.env.example
api_keys*
*.key
*.pem
credentials*
secrets*
*token*
*.secret

# --- IDE / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db
*.backup_*
.backup_*

# --- decoupling helper scripts (not shipped) ---
/_decouple*.py

# --- pre-existing truncated/corrupt source files (not shippable) ---
/Technical/src/data/test_collectors_simple.py
/Technical/src/z1_bop_latex_templates.py

# --- Build transcripts and generated document scaffolding ---
*.log
*.aux
*.out
*.toc
*.synctex.gz

